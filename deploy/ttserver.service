[Unit]
Description=TeamTalk Go registration server + ntfy bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Rendered by deploy.sh: @USER@ is the account running the service, @DIR@ is
# the checkout directory. Edit deploy.sh variables, not this file.
User=@USER@
WorkingDirectory=@DIR@
EnvironmentFile=@DIR@/.env
ExecStart=@DIR@/ttserver
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
