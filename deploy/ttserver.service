[Unit]
Description=TeamTalk Go registration server + ntfy bot
After=network-online.target tt5@deniz.service
Wants=network-online.target

[Service]
Type=simple
User=denizsincar29
WorkingDirectory=/home/deniz/teamtalk_reg_system
EnvironmentFile=/home/deniz/teamtalk_reg_system/.env
ExecStart=/home/deniz/teamtalk_reg_system/ttserver
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
