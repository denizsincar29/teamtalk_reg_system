# TeamTalk Registration System configuration
# Created by Deniz Sincar (denizsincar.ru)
# Copy this file to .env and fill in your values.
#
# The Go server (recommended, see README) reads every key below except the
# ones explicitly marked "Python only". The legacy Python app reads the same
# base keys plus FORWARDED_ALLOW_IPS and ROOT_PATH.

# ── TeamTalk server ─────────────────────────────────────────────────────────
# Public host users connect to; it goes into .tt files and tt:// URLs.
TEAMTALK_HOST=your-teamtalk-server.com
TEAMTALK_TCP_PORT=10333
TEAMTALK_UDP_PORT=10333

# Account the bot logs in with. It must exist on the TeamTalk server with
# enough rights to create users.
TEAMTALK_USERNAME=bot
TEAMTALK_PASSWORD=your_password_here

# Display name shown to other users on the server (defaults to the username).
TEAMTALK_NICKNAME="Registration Bot"

# Set to true when the web app runs on the same machine as the TeamTalk
# server: the bot then dials localhost while users keep TEAMTALK_HOST.
USE_LOCALHOST_FOR_BOT=false

# Channel the bot joins right after login; 0 = stay in the root channel.
BOT_JOIN_CHANNEL_ID=0

# ── Web server ──────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Links ───────────────────────────────────────────────────────────────────
# Host of the small /tturl redirector. Messenger clients only link https URLS,
# so a tt:// address shared in a chat travels as
# https://<TT_SHORT_HOST>/tturl?... Defaults to tt.<TEAMTALK_HOST>.
TT_SHORT_HOST=tt.your-domain.com

# tt:// address a push-notification tap should log into (a personal admin
# account). Empty = use the bot account.
ADMIN_TT_URL=

# ── Personal-data policy (optional) ─────────────────────────────────────────
# The registration form asks for consent only when a policy is configured.
# PRIVACY_URL — link to your own policy page (any http(s) address).
# PRIVACY_FILE — path to a plain-text policy served at /privacy instead, for
#   servers that have no page of their own. Read on every request.
# With both empty the consent checkbox is not shown and not required.
PRIVACY_URL=
PRIVACY_FILE=

# Note written into the TeamTalk account as proof of consent (visible to
# admins in the account list). Empty = built from the policy link; set it to
# keep your own wording, e.g. "Согласие с политикой ПДн от 15.09.2026".
# Ignored when no policy is configured.
CONSENT_NOTE=

# ── Storage ─────────────────────────────────────────────────────────────────
# Where scheduled tasks and queued offline messages are kept.
DATA_DIR=data

# ── ntfy push notifications (optional) ──────────────────────────────────────
# Leave NTFY_URL empty to disable notifications. NTFY_URL wins when set;
# otherwise it is built as <NTFY_SERVER>/<NTFY_TOPIC>.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_URL=
NTFY_USERNAME=
NTFY_PASSWORD=

# ── Python app only ─────────────────────────────────────────────────────────
# Allowed proxy IPs for X-Forwarded headers.
FORWARDED_ALLOW_IPS=*
# URL path prefix when proxied under a subpath (e.g. /myapp).
ROOT_PATH=
